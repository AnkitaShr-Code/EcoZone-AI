# Copy to .env for local runs. Never put keys here: auth is Application Default Credentials
# (`gcloud auth application-default login`) locally and the service account on Cloud Run.

# Area bundle directory (local path or gs:// URI); unset until WP4 produces bundle v1
ECOZONE_BUNDLE_URI=
# memory (local, tests) or firestore (prod)
ECOZONE_STORE=memory
GOOGLE_CLOUD_PROJECT=
# Vertex AI location and model ids, verified against the Vertex model list (WP3)
ECOZONE_GEMINI_LOCATION=
ECOZONE_MODEL_PROPOSER=
ECOZONE_MODEL_WRITER=
# gemini (default) or fake: fake runs the offline rule proposer and template text, with no cloud calls
# ECOZONE_LLM=fake
