# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.hypothesis/

# Local data: bundles and pipeline cache (ENGINEERING_RULES.md §4)
data/
# ...except the heat-check surface temperature table the evals read (evals/heat_check/README.md)
!evals/heat_check/data/

# Secrets and local config (ENGINEERING_RULES.md principle 8)
.env
.env.*
!.env.example

# Local tool config
.claude/
.DS_Store

# Eval runs: local JSONL rows; only the final run is committed (evals/RULES.md)
evals/results/*
!evals/results/final.jsonl
!evals/results/.gitkeep
